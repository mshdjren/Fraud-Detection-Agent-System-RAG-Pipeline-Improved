{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "uid": "fraud-load-verification",
  "title": "Fraud AgentRAG · Load Verification (부하로만 검증 가능한 3요소)",
  "description": "batch inference로 재현되지 않는 3가지만 검증한다.\n ① Row2 압축 이득의 인과 (page fault ↔ p95)\n ② Row3 포화점 (RPS × p95 × 큐 적체)\n ③ Row4 동시성 하 LLM 붕괴점\n나머지(recall/AUROC/working set/단건 latency/토큰 수)는 batch로 충분하므로 제외.",
  "tags": [
    "fraud",
    "load-test",
    "locust",
    "verification"
  ],
  "time": {
    "from": "now-45m",
    "to": "now"
  },
  "refresh": "15s",
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "15s",
      "30s",
      "1m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "GMP",
          "value": "GMP"
        },
        "hide": 0,
        "label": "Datasource"
      },
      {
        "name": "run_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "label": "Run ID (variant)",
        "query": "label_values(retriever_search_latency_ms_count, run_id)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "c-quant-bbqos3",
          "value": "c-quant-bbqos3"
        },
        "description": "f32 vs bbq 비교의 핵심 변수. 같은 부하를 variant별로 두 번 돌린다."
      },
      {
        "name": "stage",
        "type": "custom",
        "label": "Locust Stage",
        "query": "stage1-router,stage2-router-retriever,stage3-full,stage4-pagefault",
        "current": {
          "text": "stage4-pagefault",
          "value": "stage4-pagefault"
        },
        "includeAll": false,
        "multi": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Row 1 · Load — Locust 부하 계단 (x축 기준)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 101,
      "type": "timeseries",
      "title": "Locust RPS (3-stage 계단)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum(locust_requests_current_rps)",
          "legendFormat": "RPS",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum(locust_requests_current_fail_per_sec)",
          "legendFormat": "fail/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "동시 사용자 수 (users)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum(locust_users)",
          "legendFormat": "users",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "요청률 · 에러율 (서버 관측)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum(rate(detect_requests_total[1m]))",
          "legendFormat": "detect rps",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum(rate(detect_requests_total{status=~\"5..\"}[1m])) / clamp_min(sum(rate(detect_requests_total[1m])),0.001)",
          "legendFormat": "error rate",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Row 2 ★ 압축 이득의 인과 — page fault ↔ retriever p95 (핵심 패널)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 201,
      "type": "timeseries",
      "title": "★ retriever p95  vs  page fault/req  (dual-axis)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(retriever_search_latency_ms_bucket{run_id=\"$run_id\"}[2m])))",
          "legendFormat": "retriever p95 (ms)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(retriever_page_fault_delta_bucket{run_id=\"$run_id\"}[2m])))",
          "legendFormat": "page fault p95 /req",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum(rate(retriever_page_fault_delta_sum{run_id=\"$run_id\"}[2m]))",
          "legendFormat": "page fault rate (total/s)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*page fault.*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    8,
                    4
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "★ 이 프로젝트의 핵심 주장 — '압축(Coreset/BBQ)의 latency 이득은 page fault가 발생할 때만 발현된다'. 두 곡선이 같은 시점에 함께 튀어야 인과가 성립한다.\n\n실행: $run_id를 c-quant-f32 → c-quant-bbqos3 로 전환하며 같은 Locust 부하를 두 번 돌리고 스크린샷 2장을 나란히 비교.\n\n전제: docs 노드 resources.limits.memory를 낮춰 page cache를 조여야 f32에서 pf가 발생한다. 안 하면 두 장이 똑같이 나온다(working set이 cache에 다 들어가면 f32도 pf=0)."
    },
    {
      "id": 202,
      "type": "stat",
      "title": "page fault 없는 요청 비율",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum(rate(retriever_page_fault_delta_bucket{run_id=\"$run_id\", le=\"0\"}[5m])) / clamp_min(sum(rate(retriever_page_fault_delta_count{run_id=\"$run_id\"}[5m])),0.001)",
          "legendFormat": "pf=0 비율",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
