      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum by (type) (elasticsearch_thread_pool_queue_count{type=~\"search|write\"})",
          "legendFormat": "queue {{type}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum by (type) (rate(elasticsearch_thread_pool_rejected_count{type=~\"search\"}[2m]))",
          "legendFormat": "rejected/s {{type}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
