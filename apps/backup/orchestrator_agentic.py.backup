VALID_EXPERIMENT_CASES = [
    "emb_vectors",
    "pca_32", "pca_64", "pca_128", "pca_256",
    "k50", "k100", "k200",
    "pca_64_k100", "pca_64_k200",
]
VALID_PERCOLATE_VERSIONS = ["v1", "v2", "v3", "v4", "v5","v6","v7","v8","v9","v10","v11","v12","v13","v11a","v11b","v11c","v14"]



# ===========================
# FastAPI & Logger
